---
import "@fontsource/spectral-sc/latin-600.css"
import "../styles/global.css"
import { profile } from "../data/profile"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title = profile.seo.title, description = profile.seo.description, noindex = false } = Astro.props
const site = Astro.site ?? new URL("https://amoddhopavkar.com")
const canonical = new URL(Astro.url.pathname, site).href
const image = new URL(profile.seo.image, site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fff1e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <!-- Bump ?v= when the icons change: browsers cache favicons aggressively. -->
    <link rel="icon" href="/favicon.ico?v=6" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=6" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=6" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Link previews (LinkedIn, Slack, X) read these from <head>. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={profile.seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={profile.seo.imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: profile.name,
      jobTitle: "Software Engineer",
      worksFor: { "@type": "Organization", name: "Goldman Sachs" },
      url: site.href,
      sameAs: [profile.links.github, profile.links.linkedin],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
