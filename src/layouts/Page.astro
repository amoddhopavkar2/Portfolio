---
import Base from "./Base.astro"
import { profile } from "../data/profile"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title, description, noindex } = Astro.props
// The Books link appears once the first book note exists.
const hasBooks = Object.keys(import.meta.glob("../content/books/*.md")).length > 0

const nav = [
  { href: "/writing", label: "Writing" },
  ...(hasBooks ? [{ href: "/books", label: "Books" }] : []),
  { href: "/projects", label: "Projects" },
  { href: "/outside", label: "Outside" },
  { href: "/work", label: "Work" },
  { href: "/now", label: "Now" },
]
const path = Astro.url.pathname.replace(/\/$/, "")
const year = new Date().getFullYear()
---

<Base title={title} description={description} noindex={noindex}>
  <div class="page">
    <header class="site-header">
      <a class="site-header__name" href="/">{profile.name}</a>
      <nav class="site-nav" aria-label="Site">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
      <p class="footer__meta">
        <a href="/rss.xml">RSS</a> · © {year} {profile.name}
      </p>
    </footer>
  </div>
</Base>
