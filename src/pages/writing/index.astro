---
import Page from "../../layouts/Page.astro"
import { profile } from "../../data/profile"
import { getCollection } from "astro:content"

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
---

<Page title={`Writing | ${profile.name}`} description="Notes on software, habits and the things I build.">
  <header class="page-header">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Notes on software, habits and the things I build. <a href="/rss.xml">RSS</a>.</p>
  </header>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}/`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Page>
