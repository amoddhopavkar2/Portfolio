---
import Page from "../layouts/Page.astro"
import { profile } from "../data/profile"
import { getCollection } from "astro:content"

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
---

<Page>
  <article class="prose home">
    <p class="home__role">
      Software engineer at Goldman Sachs{" · "}
      <a href={profile.links.resume}>Resume</a>{" · "}
      <a href={profile.links.github} rel="me noopener">GitHub</a>{" · "}
      <a href={profile.links.linkedin} rel="me noopener">LinkedIn</a>
    </p>

    <p>
      I'm Amod. I live in Salt Lake City and build backend and platform systems at Goldman Sachs:
      Java services on Kubernetes, data pipelines, APIs and authentication.
    </p>

    <p>
      I moved to the US in 2022 for a master's in computer science at Northeastern.
      Since then I have solved a LeetCode problem every day for a thousand days,
      visited all five of Utah's national parks, and in June{" "}
      <a href="/outside/#skydive">jumped out of a plane near San Diego</a>.
    </p>

    <p>
      I read mostly non-fiction. I build small tools I want to use myself, like{" "}
      <a href="/projects/#clauseguard">ClauseGuard</a>. When I'm not at a keyboard I'm usually
      planning the next trip or watching a Formula 1 race.
    </p>

    <p>
      The best way to reach me is <a href={`mailto:${profile.email}`}>email</a>.
    </p>
  </article>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="recent">
      <h2 id="recent" class="section__title">Recent writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}
</Page>
